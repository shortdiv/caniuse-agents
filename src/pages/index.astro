---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  BASELINE_TITLES,
  baselineGaps,
  getBaseline,
  getFeatureData,
  loadAgents,
  loadCategories,
  monthYear,
  type Baseline,
} from "../lib/data.js";
import type { Feature } from "../lib/types";

const [categories, agents] = await Promise.all([
  loadCategories(),
  loadAgents(),
]);

const totalFeatures = categories.reduce(
  (count, category) => count + category.features.length,
  0,
);

// Baseline per feature, to group each category by how widely it works.
const baselines = new Map<string, Baseline>(
  await Promise.all(
    categories.flatMap((c) => c.features).map(
      async (f) => [f.id, getBaseline(await getFeatureData(f.id), agents)] as const,
    ),
  ),
);
const STATUSES = ["widely", "newly", "limited"] as const;
const grouped = (features: Feature[]) =>
  STATUSES.map((status) => ({
    status,
    features: features.filter((f) => baselines.get(f.id)?.status === status),
  })).filter((g) => g.features.length);
const detail = (b: Baseline | undefined) =>
  !b ? "" : b.status === "limited" ? baselineGaps(b) : b.status === "newly" ? `widely available from ${monthYear(b.widelyFrom)}` : "";

const featureRows = categories.flatMap((category) =>
  category.features.map((feature: Feature) => ({
    ...feature,
    category: category.title,
    categorySlug: category.category,
  })),
);
---

<Layout title="Can I Use Agents?">
  <SiteHeader
    agentCount={agents.length}
    featureCount={totalFeatures}
    features={featureRows.map((f) => ({
      id: f.id,
      title: f.title,
      description: f.description,
      category: f.category,
    }))}
  />

  <main class="page-shell">
    {/* Category index — flat row */}
    <nav class="cat-index" aria-label="Feature categories">
      <div class="cat-index-head">
        <span class="cat-index-label">Category index</span>
      </div>
      <div class="cat-index-row">
        {
          categories.map((category) => (
            <a href={`#${category.category}`} class="cat-link">
              <span class="cat-link-name">{category.title}</span>
              <span class="cat-link-count">{category.features.length}</span>
            </a>
          ))
        }
      </div>
    </nav>

    {/* Feature sections — one per category */}
    <div id="feature-index">
      {
        categories.map((category) => (
          <section
            id={category.category}
            class="feature-section"
            data-category-card
            data-category={category.title.toLowerCase()}
          >
            <div class="feature-section-header">
              <div class="feature-section-left">
                <div class="feature-section-kicker">{category.category}</div>
                <h3 class="feature-section-title">{category.title}</h3>
                <p class="feature-section-desc">{category.description}</p>
              </div>
              <span class="feature-count">
                {category.features.length} features
              </span>
            </div>

            <div class="baseline-groups">
              {grouped(category.features).map(({ status, features }) => (
                <div class={`bl-group bl-group--${status}`} data-bl-group>
                  <h4 class="bl-group-title">
                    <span class="bl-mark" aria-hidden="true"></span>
                    {BASELINE_TITLES[status]}
                    <span class="bl-count">{features.length}</span>
                  </h4>
                  {status === "widely" ? (
                    <div class="bl-inline">
                      {features.map((feature) => (
                        <a
                          href={`/features/${feature.id}`}
                          class="bl-inline-item"
                          title={feature.description}
                          data-feature-item
                          data-searchable={`${feature.title} ${feature.description} ${category.title} ${category.category}`.toLowerCase()}
                        >
                          {feature.title}
                        </a>
                      ))}
                    </div>
                  ) : (
                    <ul class="bl-rows">
                      {features.map((feature) => (
                        <li
                          data-feature-item
                          data-searchable={`${feature.title} ${feature.description} ${category.title} ${category.category}`.toLowerCase()}
                        >
                          <a href={`/features/${feature.id}`} title={feature.description}>{feature.title}</a>
                          <span class="bl-leader" aria-hidden="true"></span>
                          <span class="bl-detail">{detail(baselines.get(feature.id))}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>

  </main>

  <SiteFooter />

  <script>
    const searchInput = document.querySelector("#feature-search");
    const status = document.querySelector("#search-status");
    const categoryCards = [
      ...document.querySelectorAll("[data-category-card]"),
    ];
    const allItems = [...document.querySelectorAll("[data-feature-item]")];

    const updateSearch = () => {
      const query = (
        searchInput instanceof HTMLInputElement ? searchInput.value : ""
      )
        .trim()
        .toLowerCase();

      let visibleItems = 0;

      for (const item of allItems) {
        const haystack = item.getAttribute("data-searchable") ?? "";
        const matches = query === "" || haystack.includes(query);
        item.toggleAttribute("hidden", !matches);

        if (matches) {
          visibleItems += 1;
        }
      }

      for (const group of document.querySelectorAll("[data-bl-group]")) {
        const visible = group.querySelectorAll("[data-feature-item]:not([hidden])").length;
        group.toggleAttribute("hidden", visible === 0);
      }

      for (const card of categoryCards) {
        const matchingChildren = card.querySelectorAll(
          "[data-feature-item]:not([hidden])",
        ).length;
        card.toggleAttribute("hidden", matchingChildren === 0);
      }

      if (status) {
        status.textContent =
          query === ""
            ? `Showing all ${allItems.length} feature entries on this page.`
            : `Showing ${visibleItems} matching feature entries for "${query}".`;
      }
    };

    searchInput?.addEventListener("input", updateSearch);

    // If navigated here with ?q=, prefill and run search
    const params = new URLSearchParams(window.location.search);
    const q = params.get("q");
    if (q && searchInput instanceof HTMLInputElement) {
      searchInput.value = q;
      updateSearch();
    }
  </script>
</Layout>

<style>
  :global(body) {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
  }

  :global(a) {
    color: inherit;
  }

  .page-shell {
    width: 100%;
  }

  /* ─── Category index ─── */
  .cat-index {
    background: var(--bg-sunken, var(--surface-alt));
    width: 100%;
  }

  .cat-index-head {
    padding: 16px 24px 6px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    max-width: 1160px;
    margin: 0 auto;
  }

  .cat-index-label {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .cat-index-hint {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-subtle);
  }

  .cat-index-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    padding: 0 16px 16px;
    gap: 4px;
    max-width: 1160px;
    margin: 0 auto;
  }

  .cat-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 14px;
    text-decoration: none;
    border-radius: 2px;
    background-color: var(--bg);
  }

  .cat-link:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  @media (prefers-color-scheme: dark) {
    .cat-link:hover {
      background: rgba(255, 255, 255, 0.04);
    }
  }

  .cat-link-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .cat-link-count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-subtle);
    font-weight: 600;
  }

  /* ─── Feature sections ─── */
  .feature-section {
    background: var(--bg);
  }

  .feature-section-header {
    padding: 28px 24px 14px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
    max-width: 1160px;
    margin: 0 auto;
  }

  .feature-section-left {
    flex: 1;
    min-width: 280px;
  }

  .feature-section-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .feature-section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 8px;
  }

  .feature-section-desc {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0;
  }

  .feature-count {
    flex-shrink: 0;
    padding: 4px 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: 2px;
    white-space: nowrap;
  }

  /* ─── Baseline groups ─── */
  .baseline-groups {
    padding: 4px 24px 28px;
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    gap: 18px;
  }
  .bl-group { display: grid; gap: 8px; }
  .bl-group--widely, .bl-group--newly { --bl-color: var(--moss); }
  .bl-group--limited { --bl-color: var(--ochre); }
  .bl-group-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bl-color);
  }
  .bl-mark {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--bl-color);
    flex-shrink: 0;
  }
  .bl-group--widely .bl-mark { background: var(--bl-color); }
  .bl-group--newly .bl-mark { background: linear-gradient(90deg, var(--bl-color) 50%, transparent 50%); }
  .bl-group--limited .bl-mark { border-style: dashed; }
  .bl-count { color: var(--text-subtle); font-weight: 500; }

  .bl-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding-left: 20px;
  }
  .bl-inline-item {
    font-size: 14px;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .bl-inline-item:hover, .bl-rows a:hover { border-bottom-color: var(--accent); color: var(--text); }

  .bl-rows {
    list-style: none;
    margin: 0;
    padding: 0 0 0 20px;
    display: grid;
    gap: 6px;
  }
  .bl-rows li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    min-width: 0;
  }
  .bl-rows a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    flex-shrink: 0;
  }
  .bl-leader {
    flex: 1;
    min-width: 24px;
    border-bottom: 1px dotted var(--border-strong, var(--text-subtle));
    opacity: 0.35;
    transform: translateY(-3px);
  }
  .bl-detail {
    font-size: 13px;
    color: var(--text-muted);
    text-align: right;
  }

  /* ─── Footer ─── */

  [hidden] {
    display: none !important;
  }

  @media (max-width: 600px) {
    .bl-rows li { flex-wrap: wrap; }
    .bl-leader { display: none; }
    .bl-detail { flex-basis: 100%; text-align: left; }
  }

  @media (max-width: 700px) {
    .feature-section-header {
      padding: 20px 16px 10px;
      flex-direction: column;
    }

    .baseline-groups {
      padding: 4px 16px 20px;
    }

    .cat-index-row {
      grid-template-columns: 1fr;
    }
  }
</style>
