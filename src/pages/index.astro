---
import type { GetStaticPaths } from "astro";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  BASELINE_TITLES,
  baselineGaps,
  getBaseline,
  getFeatureData,
  loadAgents,
  loadCategories,
  searchEntry,
  type Baseline,
} from "../lib/data.js";
import type { Feature } from "../lib/types";
import { getAgentMark } from "../lib/agent-meta";

const [categories, agents] = await Promise.all([
  loadCategories(),
  loadAgents(),
]);

const totalFeatures = categories.reduce(
  (count, category) => count + category.features.length,
  0,
);

// Baseline per feature, shown as a pattern on its card.
const baselines = new Map<string, Baseline>(
  await Promise.all(
    categories.flatMap((c) => c.features).map(
      async (f) => [f.id, getBaseline(await getFeatureData(f.id), agents)] as const,
    ),
  ),
);
const SHORT = { widely: "Widely", newly: "Newly", limited: "Limited" } as const;
// Card colour follows the feature table's legend: supported (green), partial (amber), no (orange).
// Each agent's current support for a limited feature, for the logo row.
const STATE_LABEL = { y: "full support", a: "partial support", n: "no support", u: "unknown", d: "deprecated" } as const;
const agentStates = (b: Baseline) =>
  agents.map((agent) => {
    const gap = b.status === "limited" ? b.gaps.find((g) => g.agent === agent.name) : undefined;
    const state = (gap?.support ?? "y") as keyof typeof STATE_LABEL;
    return { agent, state, mark: getAgentMark(agent.id, agent.name), label: `${agent.name}: ${STATE_LABEL[state]}` };
  });
const tone = (b: Baseline) =>
  b.status !== "limited" ? "yes" : b.gaps.length < agents.length ? "partial" : "no";
// Within a category: widely available first, then newly, then limited (original order otherwise).
const ORDER = { widely: 0, newly: 1, limited: 2 } as const;
const byAvailability = (features: Feature[]) =>
  [...features].sort((a, b) => ORDER[baselines.get(a.id)!.status] - ORDER[baselines.get(b.id)!.status]);

---

<Layout title="Can I Use Agents?">
  <SiteHeader
    agentCount={agents.length}
    featureCount={totalFeatures}
    features={categories.flatMap((c) => c.features.map((f) => searchEntry(f, c.title)))}
    agents={agents.map((a) => ({ id: a.id, name: a.name, version: a.current_version }))}
  />

  <main class="page-shell">
    {/* Category index — flat row */}
    <nav class="cat-index" aria-label="Feature categories">
      <div class="cat-index-head">
        <span class="cat-index-label">Category index</span>
      </div>
      <div class="cat-index-row">
        {
          categories.map((category) => (
            <a href={`#${category.category}`} class="cat-link">
              <span class="cat-link-name">{category.title}</span>
              <span class="cat-link-count">{category.features.length}</span>
            </a>
          ))
        }
      </div>
    </nav>

    {/* Feature sections — one per category */}
    <div id="feature-index">
      {
        categories.map((category) => (
          <section
            id={category.category}
            class="feature-section"
            data-category-card
            data-category={category.title.toLowerCase()}
          >
            <div class="feature-section-header">
              <div class="feature-section-left">
                <div class="feature-section-kicker">{category.category}</div>
                <h3 class="feature-section-title">{category.title}</h3>
                <p class="feature-section-desc">{category.description}</p>
              </div>
              <span class="feature-count">
                {category.features.length} features
              </span>
            </div>

            <div class="feature-cards">
              {byAvailability(category.features).map((feature) => {
                const baseline = baselines.get(feature.id)!;
                return (
                <a
                  href={`/features/${feature.id}`}
                  class={`feature-card bl-${baseline.status} tone-${tone(baseline)}`}
                  data-feature-item
                  data-searchable={`${feature.title} ${feature.description} ${category.title} ${category.category} ${searchEntry(feature, category.title).events}`.toLowerCase()}
                >
                  <div class="feature-card-top">
                    <span class="feature-card-title">{feature.title}</span>
                    <span class="bl-tag" title={`Baseline: ${BASELINE_TITLES[baseline.status]}`}>
                      <span class="bl-mark" aria-hidden="true"></span>
                      {SHORT[baseline.status]}
                    </span>
                  </div>
                  <span class="feature-card-desc">{feature.description}</span>
                  {baseline.status === "limited" && (
                    <span class="agent-row" aria-label={baselineGaps(baseline)}>
                      {agentStates(baseline).map(({ agent, state, mark, label }) => (
                        <span class={`agent-icon state-${state}`} title={label}>
                          {mark.logo && mark.logoDark ? (
                            <>
                              <img class="logo-light" src={mark.logo} alt="" width="16" height="16" />
                              <img class="logo-dark" src={mark.logoDark} alt="" width="16" height="16" />
                            </>
                          ) : mark.logo ? (
                            <img src={mark.logo} alt="" width="16" height="16" />
                          ) : (
                            <span class="agent-mono" style={`background:${mark.color}`}>{mark.short}</span>
                          )}
                        </span>
                      ))}
                    </span>
                  )}
                </a>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>

  </main>

  <SiteFooter />

  <script>
    const searchInput = document.querySelector("#feature-search");
    const status = document.querySelector("#search-status");
    const categoryCards = [
      ...document.querySelectorAll("[data-category-card]"),
    ];
    const allItems = [...document.querySelectorAll("[data-feature-item]")];

    const updateSearch = () => {
      const query = (
        searchInput instanceof HTMLInputElement ? searchInput.value : ""
      )
        .trim()
        .toLowerCase();

      let visibleItems = 0;

      for (const item of allItems) {
        const haystack = item.getAttribute("data-searchable") ?? "";
        const matches = query === "" || haystack.includes(query);
        item.toggleAttribute("hidden", !matches);

        if (matches) {
          visibleItems += 1;
        }
      }

      for (const card of categoryCards) {
        const matchingChildren = card.querySelectorAll(
          "[data-feature-item]:not([hidden])",
        ).length;
        card.toggleAttribute("hidden", matchingChildren === 0);
      }

      if (status) {
        status.textContent =
          query === ""
            ? `Showing all ${allItems.length} feature entries on this page.`
            : `Showing ${visibleItems} matching feature entries for "${query}".`;
      }
    };

    searchInput?.addEventListener("input", updateSearch);

    // If navigated here with ?q=, prefill and run search
    const params = new URLSearchParams(window.location.search);
    const q = params.get("q");
    if (q && searchInput instanceof HTMLInputElement) {
      searchInput.value = q;
      updateSearch();
    }
  </script>
</Layout>

<style>
  :global(body) {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
  }

  :global(a) {
    color: inherit;
  }

  .page-shell {
    width: 100%;
  }

  /* ─── Category index ─── */
  .cat-index {
    background: var(--bg-sunken, var(--surface-alt));
    width: 100%;
  }

  .cat-index-head {
    padding: 16px 24px 6px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    max-width: 1160px;
    margin: 0 auto;
  }

  .cat-index-label {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .cat-index-hint {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-subtle);
  }

  .cat-index-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    padding: 0 16px 16px;
    gap: 4px;
    max-width: 1160px;
    margin: 0 auto;
  }

  .cat-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 14px;
    text-decoration: none;
    border-radius: 2px;
    background-color: var(--bg);
  }

  .cat-link:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  @media (prefers-color-scheme: dark) {
    .cat-link:hover {
      background: rgba(255, 255, 255, 0.04);
    }
  }

  .cat-link-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .cat-link-count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-subtle);
    font-weight: 600;
  }

  /* ─── Feature sections ─── */
  .feature-section {
    background: var(--bg);
  }

  .feature-section-header {
    padding: 28px 24px 14px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
    max-width: 1160px;
    margin: 0 auto;
  }

  .feature-section-left {
    flex: 1;
    min-width: 280px;
  }

  .feature-section-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .feature-section-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 8px;
  }

  .feature-section-desc {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0;
  }

  .feature-count {
    flex-shrink: 0;
    padding: 4px 9px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: 2px;
    white-space: nowrap;
  }

  /* ─── Feature cards ─── */
  .feature-cards {
    padding: 4px 24px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 1160px;
    margin: 0 auto;
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: var(--bg-elev, var(--surface));
    border: 1px solid var(--border);
    padding: 14px 16px;
    border-radius: 2px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 90ms ease;
  }

  .feature-card:hover {
    border-color: var(--accent);
  }

  /* Baseline treatment in the feature table's legend colours:
     supported (widely/newly), partial (limited, someone has it), no (nobody has it). */
  .feature-card.tone-yes {
    --bl-color: var(--status-yes-text);
    background: var(--status-yes-bg);
  }
  .feature-card.tone-partial {
    --bl-color: var(--status-partial-text);
    background: var(--status-partial-bg);
  }
  .feature-card.tone-no {
    --bl-color: var(--status-no-text);
    background: var(--status-no-bg);
  }

  .bl-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    font: 600 10px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bl-color);
    padding-top: 2px;
  }
  /* Widely: solid. Newly: diagonal lines (supported everywhere, not settled yet). Limited: half filled. */
  .bl-mark {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--bl-color);
  }
  .bl-widely .bl-mark { background: var(--bl-color); }
  .bl-newly .bl-mark {
    background: repeating-linear-gradient(-45deg, var(--bl-color) 0 1px, transparent 1px 2.5px);
  }
  .bl-limited .bl-mark { background: linear-gradient(90deg, var(--bl-color) 50%, transparent 50%); }

  /* Logo row on limited cards: every logo in full colour; the badge carries the status. */
  .agent-row {
    display: flex;
    gap: 14px;
    margin-top: 4px;
  }
  .agent-icon {
    position: relative;
    display: inline-flex;
    width: 16px;
    height: 16px;
  }
  .agent-icon img { width: 16px; height: 16px; object-fit: contain; }
  .agent-mono {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    font: 700 7px/1 var(--font-mono);
    color: #fff;
  }
  /* Status badge on each logo, like web.dev's Baseline widget. */
  .agent-icon::after {
    position: absolute;
    right: -5px;
    bottom: -4px;
    display: grid;
    place-items: center;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    font: 700 7px/1 var(--font-mono);
    color: var(--bg);
    box-shadow: 0 0 0 1.5px var(--status-partial-bg);
  }
  .tone-yes .agent-icon::after { box-shadow: 0 0 0 1.5px var(--status-yes-bg); }
  .agent-icon.state-y::after { content: "✓"; background: var(--status-yes-text); }
  .agent-icon.state-a::after { content: "~"; background: var(--status-partial-text); }
  .agent-icon.state-n::after,
  .agent-icon.state-d::after { content: "✕"; background: var(--status-no-text); }
  .agent-icon.state-u::after { content: "?"; background: var(--text-subtle); }
  .logo-dark { display: none; }
  @media (prefers-color-scheme: dark) {
    .logo-light { display: none; }
    .logo-dark { display: block; }
  }

  .feature-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }

  .feature-card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
    line-height: 1.3;
  }

  .feature-card-desc {
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* ─── Footer ─── */

  [hidden] {
    display: none !important;
  }

  @media (max-width: 900px) {
    .feature-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .feature-section-header {
      padding: 20px 16px 10px;
      flex-direction: column;
    }

    .feature-cards {
      padding: 4px 16px 16px;
    }

    .cat-index-row {
      grid-template-columns: 1fr;
    }
  }
</style>
